# ─── Database ─────────────────────────────────────────────────────────────────
# Full PostgreSQL connection string
DATABASE_URL=postgresql://shrinkr_user:shrinkr_pass@localhost:5432/shrinkr_db

# ─── App ──────────────────────────────────────────────────────────────────────
APP_NAME=Shrinkr
# Set to False in production. True enables /docs, DEBUG log level, relaxed CORS.
DEBUG=False
BASE_URL=https://your-domain.com

# ─── Security ─────────────────────────────────────────────────────────────────
# Generate a secure key: openssl rand -hex 32
SECRET_KEY=CHANGE_ME_generate_with_openssl_rand_hex_32
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_HOURS=24

# ─── CORS ─────────────────────────────────────────────────────────────────────
# Your frontend's URL — requests from other origins will be blocked
FRONTEND_URL=https://your-frontend-domain.com

# ─── Redis ────────────────────────────────────────────────────────────────────
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=
# Set to True when using a managed Redis with TLS (e.g. Render Redis)
REDIS_SSL=False

# ─── Email (SMTP / Gmail App Password) ────────────────────────────────────────
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your_email@gmail.com
# Generate at: https://myaccount.google.com/apppasswords
SMTP_PASSWORD=your_gmail_app_password
SMTP_FROM=your_email@gmail.com

# ─── Default Admin Account ────────────────────────────────────────────────────
# These are used once at first startup to create the admin user.
# DEFAULT_ADMIN_PASSWORD is REQUIRED — startup will fail if not set.
DEFAULT_ADMIN_EMAIL=admin@shrinkr.com
DEFAULT_ADMIN_USERNAME=admin
# Use a strong password: openssl rand -base64 24
DEFAULT_ADMIN_PASSWORD=CHANGE_ME_use_a_strong_password
